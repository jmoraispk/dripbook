{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "includeFiles": "{drip/*.py,site/library.json,site/catalog.json}",
      "excludeFiles": "{converter,discovery,payments-spike,public-domain,email-spike,scripts,docs,design-options,site/covers,site/demo-*,site/video,site/think-python*}/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
